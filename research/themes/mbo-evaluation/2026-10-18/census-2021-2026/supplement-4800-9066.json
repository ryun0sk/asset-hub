    {
      "episode_id": "mbo-9066-2025-01",
      "code": "9066",
      "name": "日新",
      "announcement_date": "2025-05-12",
      "announcement_date_status": "verified",
      "announcement_source_id": "9066-mbo-company-original",
      "announcement_locator": "PDF p1（日付・MBO実施及び賛同応募推奨決議）",
      "transaction_classification": "formal_mbo_tob",
      "motives": [
        {
          "category": "growth_investment",
          "text": "運賃市況正常化で競争が激化する中、倉庫等への投資、危険品物流など高付加価値サービス、海上・航空輸送スペースの調達力と海外事業を強化する。",
          "source_id": "9066-mbo-company-original",
          "locator": "PDF p9-10, p17",
          "availability_phase": "at_announcement",
          "evidence_kind": "issuer_or_buyer_statement"
        },
        {
          "category": "growth_investment",
          "text": "国際物流の算出・発注・書類授受・進捗管理等を一貫提供する「Forward ONE」を高度化し、省力化・効率化に対応する。ドライバー・作業員及びM&A/DX専門人材の確保・育成も課題とする。",
          "source_id": "9066-mbo-company-original",
          "locator": "PDF p10（エ）（オ）",
          "availability_phase": "at_announcement",
          "evidence_kind": "issuer_or_buyer_statement"
        },
        {
          "category": "sponsor_resources",
          "text": "危険品輸送の国内外M&Aは社内ノウハウ・人材の制約で進捗が限定的だったため、ベインのネットワーク、M&A/PMI知見、人材紹介、海外展開支援を活用する。",
          "source_id": "9066-mbo-company-original",
          "locator": "PDF p17-18（エ）(a)-(c)",
          "availability_phase": "at_announcement",
          "evidence_kind": "issuer_or_buyer_statement"
        },
        {
          "category": "long_term_governance",
          "text": "抜本施策に必要な初期・継続投資は短期の利益・CF・財務を悪化させ得るため、非公開化による中長期の意思決定と、上場維持・開示監査・IR対応資源の事業投資への振替を説明する。",
          "source_id": "9066-mbo-company-original",
          "locator": "PDF p17（イ）（ウ）",
          "availability_phase": "at_announcement",
          "evidence_kind": "issuer_or_buyer_statement"
        }
      ],
